{
  "name": "batch-video-studio-ai",
  "productName": "Batch Video Studio AI",
  "version": "2.5.0",
  "description": "Suite Profesional de Edición de Vídeo por Lotes con Visión Artificial IA",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server.js\" \"vite --port 5173 --strictPort\"",
    "server": "node server.js",
    "client": "vite --port 5173 --strictPort",
    "build": "vite build",
    "electron:dev": "concurrently \"node server.js\" \"vite --port 5173 --strictPort\" \"electron .\"",
    "electron": "electron .",
    "dist": "vite build && electron-builder --win nsis portable --x64",
    "dist:portable": "vite build && electron-builder --win portable --x64",
    "dist:installer": "vite build && electron-builder --win nsis --x64",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.gomsamurai.batchvideostudioai",
    "productName": "Batch Video Studio AI",
    "copyright": "Copyright © 2026 GomSamurai",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server.js",
      "electron/**/*",
      "package.json",
      "presets.json",
      "config.json"
    ],
    "asarUnpack": [
      "server.js"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Batch Video Studio AI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Batch-Video-Studio-AI-Portable-${version}.${ext}",
      "splashImage": "build/splash.bmp"
    }
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
